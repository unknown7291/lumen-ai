# Copy this file to .env.local and fill in values. NEVER commit .env.local.

# --- Supabase (optional for local dev; REQUIRED for database persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider (required for chat responses) ---
# Choose one: openai, openrouter, anthropic, or gemini
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional custom OpenAI-compatible endpoint
# AI_BASE_URL=https://api.openai.com/v1

# Provider-specific alternatives are also supported:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# If Supabase is empty, the app uses local dev mode and browser chat history.
